rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasClientSafeProfileShape() {
      return request.resource.data.profile.whoopConnected == false
        && request.resource.data.profile.whoopUserId == "";
    }

    function keepsServerManagedProfileFields() {
      return request.resource.data.profile.whoopConnected == resource.data.profile.whoopConnected
        && request.resource.data.profile.whoopUserId == resource.data.profile.whoopUserId;
    }

    function isValidWhoopOauthState(stateId) {
      return stateId.size() == 8
        && request.resource.data.keys().hasOnly(["continueUrl", "createdAt", "expiresAt", "provider", "userId"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.provider == "whoop"
        && request.resource.data.continueUrl is string
        && request.resource.data.continueUrl.size() > 0
        && request.resource.data.continueUrl.size() <= 300
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.createdAt >= request.time - duration.value(1, "minutes")
        && request.resource.data.createdAt <= request.time + duration.value(1, "minutes")
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(20, "minutes");
    }

    match /oauthStates/{stateId} {
      allow create: if isSignedIn() && isValidWhoopOauthState(stateId);
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && hasClientSafeProfileShape();
      allow read, delete: if isOwner(userId);
      allow update: if isOwner(userId) && keepsServerManagedProfileFields();

      match /connectedAccounts/{accountId} {
        allow read, write: if false;
      }

      match /privateCache/{document=**} {
        allow read, write: if false;
      }

      match /matches/{matchId} {
        allow read, write: if isOwner(userId);
      }

      match /opponents/{opponentId} {
        allow read, write: if isOwner(userId);
      }

      match /dailyCheckins/{dateString} {
        allow read, write: if isOwner(userId);
      }

      match /readinessScores/{dateString} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /ratings/{dateString} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }
  }
}
